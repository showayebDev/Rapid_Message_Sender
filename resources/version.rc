#include <windows.h>

IDI_ICON1 ICON "app_icon.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "ShowayebDev\0"
            VALUE "FileDescription",  "Rapid Message Sender Desktop Automation\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "RapidMessageSender\0"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Showayeb\0"
            VALUE "OriginalFilename", "RapidMessageSender.exe\0"
            VALUE "ProductName",      "Rapid Message Sender\0"
            VALUE "ProductVersion",   "1.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
